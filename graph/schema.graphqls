scalar Time

# Kubernetes pattern (e.g., Health Probe, Managed Lifecycle)
type K8sPattern {
  id: Int!
  name: String!
  description: String
  checkItems: [CheckItem!]!
  createdAt: Time!
}

# Specific check item for a pattern
type CheckItem {
  id: Int!
  patternId: Int!
  pattern: K8sPattern!
  name: String!
  description: String
  createdAt: Time!
}

# Repository information
type Repository {
  id: Int!
  nameWithOwner: String!
  stargazerCount: Int!
  primaryLanguage: String
  hasDockerfile: Boolean!
  createdAt: Time!
  isWebApp: Boolean
  webAppCheckedAt: Time
}

# Check result for a specific repository and check item
type CheckResult {
  id: Int!
  repositoryId: Int!
  repository: Repository!
  checkItemId: Int!
  checkItem: CheckItem!
  result: Boolean!
  memo: String
  checkedAt: Time!
  updatedAt: Time!
}

# Admin dashboard data
type AdminDashboard {
  patterns: [K8sPattern!]!
  repositories: [Repository!]!
  checkResults: [CheckResult!]!
}

# Mutation result
type MutationResult {
  success: Boolean!
  message: String
}

# Input for creating a check result
input NewCheckResultInput {
  repositoryId: Int!
  checkItemId: Int!
  result: Boolean!
  memo: String
}

# Input for saving repository evaluation (WebApp + CheckResults)
input RepositoryEvaluationInput {
  repositoryId: Int!
  isWebApp: Boolean!
  checkResults: [CheckResultInput!]
}

# Input for individual check result (without repositoryId)
input CheckResultInput {
  checkItemId: Int!
  result: Boolean!
  memo: String
}

# Input for creating/updating a pattern
input K8sPatternInput {
  name: String!
  description: String
}

# Input for creating/updating a check item
input CheckItemInput {
  patternId: Int!
  name: String!
  description: String
}

type EvaluatedRepositoriesStats {
  totalCount: Int!
  webAppCount: Int!
  nonWebAppCount: Int!
}

type Query {
  adminDashboard(limit: Int = 50): AdminDashboard!
  patterns: [K8sPattern!]!
  checkItems(patternId: Int): [CheckItem!]!
  checkResults(repositoryId: Int): [CheckResult!]!
  repositories(limit: Int = 100, offset: Int = 0): [Repository!]!
  unevaluatedRepositoriesWithDockerfile(limit: Int = 50, offset: Int = 0): [Repository!]!
  searchEvaluatedRepositories(query: String!, limit: Int = 50, offset: Int = 0): [Repository!]!
  evaluatedRepositoriesStats: EvaluatedRepositoriesStats!
  repository(id: Int!): Repository
}

type Mutation {
  # Check result mutations
  createCheckResult(input: NewCheckResultInput!): MutationResult!
  updateCheckResult(id: Int!, input: NewCheckResultInput!): MutationResult!
  deleteCheckResult(id: Int!): MutationResult!
  saveRepositoryEvaluation(input: RepositoryEvaluationInput!): MutationResult!

  # Pattern mutations
  createPattern(input: K8sPatternInput!): MutationResult!
  updatePattern(id: Int!, input: K8sPatternInput!): MutationResult!
  deletePattern(id: Int!): MutationResult!

  # Check item mutations
  createCheckItem(input: CheckItemInput!): MutationResult!
  updateCheckItem(id: Int!, input: CheckItemInput!): MutationResult!
  deleteCheckItem(id: Int!): MutationResult!
}
