FROM golang:1.25-bookworm AS builder

ARG PACKAGE_NAME=server

WORKDIR /app
COPY ./go.mod ./go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -trimpath -o /go-bin/${PACKAGE_NAME} ./cmd/${PACKAGE_NAME}/.

# 内部でgemini-cliを利用するため，nodeのイメージを利用
FROM debian:bookworm-slim

ARG PACKAGE_NAME=server

ENV TZ=Asia/Tokyo

# CA証明書とgitをインストール
RUN apt-get update && apt-get install -y \
  ca-certificates \
  git \
  && rm -rf /var/lib/apt/lists/* \
  && update-ca-certificates

RUN useradd -m -u 10000 ${PACKAGE_NAME}

# バイナリを配置
COPY --from=builder /go-bin/${PACKAGE_NAME} /go-bin/${PACKAGE_NAME}

RUN chown -R 10000:10000 /go-bin

WORKDIR /go-bin
# 非特権ユーザで実行
USER ${PACKAGE_NAME}

EXPOSE 80

ENV PACKAGE_NAME=${PACKAGE_NAME}

CMD ["bash", "-c", "/go-bin/${PACKAGE_NAME}"]
